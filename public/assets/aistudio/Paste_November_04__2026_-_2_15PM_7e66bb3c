              { date: "2026-10-15", drug: "Isoniazid (H)", reaction: "Peripheral Numbness (ชาปลายมือเท้า)", severity: "Mild", action: "เพิ่ม Pyridoxine เป็น 50 mg/day" }
            ],
            soapNotes: [
              { date: "2026-10-26", problem: "Post-DILI Re-challenge", subjective: "ผู้ป่วยไม่มีอาการคลื่นไส้อาเจียน ตาไม่เหลือง", objective: "AST 32 U/L, ALT 28 U/L (Normal)", assessment: "เอนไซม์ตับกลับสู่ปกติ พร้อม Re-challenge H", plan: "เริ่ม Isoniazid 300 mg/day นัดติดตาม LFT ใน 1 สัปดาห์" }
            ],
            multidisciplinaryNotes: [
              { date: "2026-10-26", sender: "ภก.วิชัย (เภสัชกร)", text: "ผล LFT กลับสู่ปกติแล้ว ให้เริ่ม Re-challenge H เป็นตัวแรก สัปดาห์ถัดไปนัดดู LFT อีกครั้ง" }
            ],
            alerts: [{ id: "ALT-01", type: "Warning", text: "อยู่ระหว่าง Re-challenge ยา หลังเกิด DILI (เอนไซม์ตับเคยสูง 210 U/L)" }]
          },
          {
            id: "TB-69-002",
            hn: "450003053",
            name: "นายภาณุพงศ์ แก้วเจริญ",
            age: 58,
            gender: "ชาย",
            weight: 58.9,
            height: 168,
            bmi: 20.9,
            patientType: "MDR/RR-TB",
            hivStatus: "Negative",
            diagnosis: "Pulmonary MDR-TB (Resistant to H & R)",
