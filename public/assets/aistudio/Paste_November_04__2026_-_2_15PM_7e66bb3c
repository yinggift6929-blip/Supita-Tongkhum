          }
        ];

        // Re-challenge protocol guidelines (Chapter 5, Page 62)
        const RECHALLENGE_STEPS = [
          { step: 1, text: "หยุดยา TB ทั้งหมด จนกว่า AST/ALT < 2x UNL และ Total Bilirubin < 1.5 mg/dL" },
          { step: 2, text: "สัปดาห์ที่ 1: เริ่มยา Isoniazid (H) ขนาดปกติ และเจาะ LFT ติดตามเมื่อครบ 1 สัปดาห์" },
          { step: 3, text: "สัปดาห์ที่ 2: หาก H ปกติ เริ่มยา Rifampicin (R) ขนาดปกติ และเจาะ LFT ติดตามเมื่อครบ 1 สัปดาห์" },
          { step: 4, text: "สัปดาห์ที่ 3: หาก R ปกติ พิจารณาเริ่ม Pyrazinamide (Z) (ถ้าจำเป็น) และเจาะ LFT ติดตาม" },
          { step: 5, text: "หากเกิดเอนไซม์ตับสูงขึ้นเกินเกณฑ์ระหว่างตัวใด ให้หยุดยาตัวนั้นทันทีและถือว่าแพ้/เกิดพิษจากยาตัวนั้น" }
        ];

        // Helper for Timeline Stats
        const getPatientTimelineStats = (patient) => {
          const regMonths = patient.extendedPhase ? patient.regimenMonths + patient.extendedMonths : patient.regimenMonths;
          const currentM = Math.min(patient.monthOfTreatment, regMonths);
          const percent = Math.min(Math.round((currentM / regMonths) * 100), 100);
          
          let cheerMessage = "";
          let cheerBadge = "";

          if (percent < 35) {
            cheerMessage = "จุดเริ่มต้นที่ยิ่งใหญ่! การทานยาอย่างเคร่งครัดใน 2 เดือนแรก คือหัวใจสำคัญที่สุดในการกำจัดเชื้อวัณโรค สู้ๆ ครับ!";
            cheerBadge = "🌱 เริ่มต้นการรักษาอย่างเข้มแข็ง";
          } else if (percent < 70) {
            cheerMessage = "เยี่ยมมากครับ! คุณผ่านช่วงระยะเข้มข้นมาแล้ว ร่างกายกำลังฟื้นตัวได้ดี ทานยาต่อเนื่องตามแพทย์สั่งต่อไปนะครับ!";
            cheerBadge = "🏃‍♂️ ก้าวเข้าสู่ระยะสมาน ร่างกายดีขึ้นต่อเนื่อง";
          } else if (percent < 100) {
            cheerMessage = `คุณเดินทางมาถึง ${percent}% แล้ว! อีกเพียงไม่กี่เดือนก็จะหายขาดจากวัณโรคได้อย่างสมบูรณ์แบบแล้วครับ!`;
            cheerBadge = "🔥 อีกนิดเดียวจะถึงเป้าหมายวันหายขาด!";
          } else {
            cheerMessage = "🎉 ยินดีด้วยอย่างยิ่ง! คุณรับประทานยาครบถ้วนตามแผนการรักษาและหายขาดจากวัณโรคแล้ว!";
            cheerBadge = "🏆 พิชิตวัณโรคสำเร็จ! หายขาด 100%";
          }

          return { regMonths, currentM, percent, cheerMessage, cheerBadge };
        };

        // Initial Patients Mock Database
        const initialPatients = [
          {
            id: "TB-69-001",
            hn: "450004413",
            name: "น.ส.โสภา หนูโม",
            age: 42,
            gender: "หญิง",
            weight: 38.6,
            height: 152,
            bmi: 16.7,
            patientType: "Drug Reaction / Allergy",
            hivStatus: "Negative",
            diagnosis: "Pulmonary TB, Post-DILI (Re-challenge Phase)",
