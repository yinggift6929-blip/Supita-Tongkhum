            durationMonths: 11,
            type: "MDR/RR-TB",
            dosingInfo: "4-6 เดือน (Bdq+Lfx+Pto+Cfz+Z+E+High-dose H) / 5 เดือน (Lfx+Cfz+Z+E)",
