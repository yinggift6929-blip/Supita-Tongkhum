            regimenName: "Shorter All-Oral Bdq Regimen (9-11 เดือน)",
            regimenMonths: 11,
            monthOfTreatment: 5,
            sputumStatus: "Negative",
            extendedPhase: false,
            extendedMonths: 0,
            adrRecords: [],
            soapNotes: [],
            multidisciplinaryNotes: [],
            alerts: [{ id: "ALT-02", type: "Info", text: "สูตรยา MDR-TB สั้น 9-11 เดือน (Bdq-based) ติดตาม EKG (QTc interval) ทุกเดือน" }]
          }
        ];

        // MAIN APP COMPONENT
        function App() {
          const [patients, setPatients] = useState(initialPatients);
          const [selectedPatientId, setSelectedPatientId] = useState(initialPatients[0].id);
          const [activeTab, setActiveTab] = useState('registry'); // registry, calculator, rechallenge
          const [searchTerm, setSearchTerm] = useState('');
          const [weightFilter, setWeightFilter] = useState('all');
          const [patientTypeFilter, setPatientTypeFilter] = useState('all');
          const [showCheerUpModal, setShowCheerUpModal] = useState(false);
          const [showNewPatientModal, setShowNewPatientModal] = useState(false);
          const [newNoteText, setNewNoteText] = useState('');

          // ADR Form State
          const [adrForm, setAdrForm] = useState({ drug: '', reaction: '', severity: 'Moderate', action: '' });
          const [showAdrModal, setShowAdrModal] = useState(false);

          // SOAP Form State
          const [soapForm, setSoapForm] = useState({ problem: '', subjective: '', objective: '', assessment: '', plan: '' });
          const [showSoapModal, setShowSoapModal] = useState(false);

          const [newPatientForm, setNewPatientForm] = useState({
            hn: '', name: '', age: '', gender: 'ชาย', weight: '', height: '',
            patientType: 'New Case (DS-TB)', diagnosis: 'Pulmonary TB, Smear Positive',
            regimenId: 'STD_2HRZE_4HR_STD', sputumStatus: 'Positive'
          });

          const selectedPatient = useMemo(() => {
            return patients.find(p => p.id === selectedPatientId) || patients[0];
          }, [patients, selectedPatientId]);

          const filteredPatients = useMemo(() => {
            return patients.filter(p => {
              const matchSearch = p.name.includes(searchTerm) || p.hn.includes(searchTerm) || p.id.includes(searchTerm);
              const matchWeight = weightFilter === 'all' ? true : weightFilter === 'low' ? p.weight < 50 : p.weight >= 50;
              const matchType = patientTypeFilter === 'all' ? true : p.patientType === patientTypeFilter;
              return matchSearch && matchWeight && matchType;
            });
          }, [patients, searchTerm, weightFilter, patientTypeFilter]);

          const handleToggleSputumStatus = (patientId) => {
            setPatients(prev => prev.map(p => {
              if (p.id === patientId) {
                const isPos = p.sputumStatus === 'Positive';
                return {
                  ...p,
                  sputumStatus: isPos ? 'Negative' : 'Positive',
                  extendedPhase: !isPos,
                  extendedMonths: !isPos ? 2 : 0,
                  alerts: !isPos 
                    ? [...p.alerts, { id: Date.now().toString(), type: 'Critical', text: '🚨 Sputum AFB (+) ในเดือนที่ 2/5 ขยายเวลาทานยาอีก 2 เดือน' }]
                    : p.alerts.filter(a => !a.text.includes('Sputum AFB (+)'))
                };
              }
              return p;
            }));
          };

          const handleAddNote = () => {
            if (!newNoteText.trim()) return;
            const noteObj = {
              date: new Date().toISOString().split('T')[0],
              sender: "ภก.คลินิก (เภสัชกร)",
              text: newNoteText
            };
            setPatients(prev => prev.map(p => p.id === selectedPatientId ? { ...p, multidisciplinaryNotes: [noteObj, ...p.multidisciplinaryNotes] } : p));
            setNewNoteText('');
          };

          const handleAddAdr = (e) => {
            e.preventDefault();
            const record = {
              date: new Date().toISOString().split('T')[0],
              ...adrForm
            };
            setPatients(prev => prev.map(p => p.id === selectedPatientId ? {
              ...p,
              adrRecords: [record, ...(p.adrRecords || [])]
            } : p));
            setAdrForm({ drug: '', reaction: '', severity: 'Moderate', action: '' });
            setShowAdrModal(false);
          };

          const handleAddSoap = (e) => {
            e.preventDefault();
            const record = {
              date: new Date().toISOString().split('T')[0],
              ...soapForm
            };
            setPatients(prev => prev.map(p => p.id === selectedPatientId ? {
              ...p,
              soapNotes: [record, ...(p.soapNotes || [])]
            } : p));
            setSoapForm({ problem: '', subjective: '', objective: '', assessment: '', plan: '' });
            setShowSoapModal(false);
          };

          const handleCreatePatient = (e) => {
            e.preventDefault();
            const selectedReg = CPG_REGIMENS.find(r => r.id === newPatientForm.regimenId) || CPG_REGIMENS[0];
            const bw = parseFloat(newPatientForm.weight) || 50;
            const ht = parseFloat(newPatientForm.height) || 160;
            const bmiVal = ((bw / ((ht / 100) ** 2))).toFixed(1);

            const newEntry = {
              id: `TB-69-00${patients.length + 1}`,
              hn: newPatientForm.hn || `${Math.floor(100000000 + Math.random() * 900000000)}`,
              name: newPatientForm.name || "ผู้ป่วย รายใหม่",
              age: parseInt(newPatientForm.age) || 45,
              gender: newPatientForm.gender,
              weight: bw,
              height: ht,
              bmi: parseFloat(bmiVal),
              patientType: newPatientForm.patientType,
              hivStatus: "Negative",
              diagnosis: newPatientForm.diagnosis,
              regimenId: selectedReg.id,
              regimenName: selectedReg.name,
              regimenMonths: selectedReg.durationMonths,
              monthOfTreatment: 1,
              sputumStatus: newPatientForm.sputumStatus,
              extendedPhase: false,
              extendedMonths: 0,
              adrRecords: [],
              soapNotes: [],
              multidisciplinaryNotes: [],
              alerts: bw < 50 ? [{ id: "ALT-NEW", type: "Warning", text: "น้ำหนักตัวน้อย (< 50 kg) คำนวณยาแยกเม็ด" }] : []
            };

            setPatients([newEntry, ...patients]);
            setSelectedPatientId(newEntry.id);
            setShowNewPatientModal(false);
          };

          return (
            <div className="min-h-screen bg-slate-50 text-slate-800 flex flex-col font-sans">
              
              {/* TOP HEADER */}
              <header className="bg-gradient-to-r from-teal-900 via-slate-900 to-teal-950 text-white shadow-md sticky top-0 z-30">
                <div className="max-w-7xl mx-auto px-4 py-3.5 flex flex-wrap justify-between items-center gap-4">
                  <div className="flex items-center gap-3">
                    <div className="bg-teal-500 p-2.5 rounded-2xl shadow-lg border border-teal-300/30">
                      <i className="fa-solid fa-user-doctor text-slate-950 text-xl"></i>
                    </div>
                    <div>
                      <div className="flex items-center gap-2">
                        <h1 className="text-lg font-black tracking-tight text-white">TB Pharmacy Care Hub</h1>
                        <span className="bg-amber-400 text-slate-950 text-[10px] font-black px-2 py-0.5 rounded-full uppercase">CPG 2021 Update</span>
